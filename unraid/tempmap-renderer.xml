<?xml version="1.0"?>
<Container version="2">
  <Name>TempMap Renderer</Name>
  <Repository>ghcr.io/rjgrandy/tempmap-renderer:main</Repository>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support/>
  <Project/>
  <Overview/>
  <Category/>
  <WebUI>http://[IP]:[PORT:8000]/</WebUI>
  <TemplateURL/>
  <Icon/>
  <ExtraParams/>
  <PostArgs/>
  <Port>
    <HostPort>8000</HostPort>
    <ContainerPort>8000</ContainerPort>
    <Protocol>tcp</Protocol>
  </Port>
  <Volume>
    <HostDir>/mnt/user/appdata/tempmap-renderer</HostDir>
    <ContainerDir>/data</ContainerDir>
    <Mode>rw</Mode>
  </Volume>
  <Volume>
    <HostDir>/mnt/user/appdata/tempmap-renderer/config.yaml</HostDir>
    <ContainerDir>/app/backend/config.yaml</ContainerDir>
    <Mode>rw</Mode>
  </Volume>
  <Environment>
    <Name>TEMP_MAP_DATA_PATH</Name>
    <Value>/data</Value>
  </Environment>
  <Environment>
    <Name>TZ</Name>
    <Value>UTC</Value>
  </Environment>
  <Environment>
    <Name>PUID</Name>
    <Value>99</Value>
  </Environment>
  <Environment>
    <Name>PGID</Name>
    <Value>100</Value>
  </Environment>
</Container>
